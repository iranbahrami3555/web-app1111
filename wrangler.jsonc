{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app1111",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "84dc2458-b878-4b93-8c13-bee6307e916d","database_name": "green" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5c7805cabb674e1bb2b5cce31d5fb15f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
